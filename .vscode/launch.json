{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug backend",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "main:app",
                "--reload",
                "--host",
                "0.0.0.0",
                "--port",
                "8000"
            ],
            "cwd": "${workspaceFolder}/backend",
            "justMyCode": true
        },
        {
            "name": "Launch frontend (Vite)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "echo",
            "runtimeArgs": [
                "Launching frontend via task"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "frontend: npm dev"
        }
    ],
    "compounds": [
        {
            "name": "Debug full stack",
            "configurations": [
                "Debug backend",
                "Launch frontend (Vite)"
            ]
        }
    ]
}