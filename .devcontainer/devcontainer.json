{
  "name": "community-devcontainer",
  "dockerComposeFile": [
    "../docker-compose.yml",
    "docker-compose.devcontainer.yml"
  ],
  "service": "devcontainer",
  "workspaceFolder": "/workspaces",
  "runServices": [
    "postgres",
    "seaweed",
    "devcontainer"
  ],
  "shutdownAction": "stopCompose",
  "overrideCommand": true,
  "initializeCommand": "sh -c 'if [ ! -f .env ] && [ -f dummy_env ]; then cp dummy_env .env; fi'",
  "postCreateCommand": "cd backend && uv pip install -r pyproject.toml --system && cd ../frontend && npm install",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {
      "version": "22"
    },
    "ghcr.io/devcontainers/features/git:1": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-azuretools.vscode-docker",
        "ms-python.debugpy"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true,
        "files.eol": "\n"
      }
    }
  },
  "forwardPorts": [
    3000,
    8000
  ],
  "portsAttributes": {
    "3000": {
      "label": "Frontend (Vite)"
    },
    "8000": {
      "label": "Backend (FastAPI)"
    },
    "5432": {
      "label": "PostgreSQL"
    },
    "9000": {
      "label": "SeaweedFS S3 API"
    },
    "9001": {
      "label": "SeaweedFS Console"
    }
  }
}